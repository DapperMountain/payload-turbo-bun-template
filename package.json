{
  "name": "accounting-for-life",
  "description": "Accounting for Life — self-hosted personal finance on Payload CMS",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "skills:update": "bunx skills update payload -y -p",
    "skills:check": "bunx skills check -p",
    "skills:install": "bunx skills add payloadcms/skills --skill payload -y --copy -a '*'",
    "hooks:install": "git-hooks",
    "hooks:uninstall": "git-hooks uninstall"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "~10.4.22",
    "bun-git-hooks": "^0.3.2",
    "cross-env": "7.0.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.10",
    "next": "16.2.10",
    "prettier": "~3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lucide-react": "^0.543.0",
    "rimraf": "~6.1.3",
    "turbo": "2.10.4",
    "typescript": "5.9.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.13"
}
